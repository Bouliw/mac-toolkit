#!/bin/zsh
# Daily, silent yt-dlp update (used by "Download Video").
# Checks the latest release first (a few KB) and only runs Homebrew when there is something new.
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
export HOMEBREW_NO_ENV_HINTS=1 HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_INSTALL_CLEANUP=1
LOG="$HOME/Library/Logs/mac-toolkit/update-ytdlp.log"

installed=$(yt-dlp --version 2>/dev/null) || exit 0
latest=$(curl -fsS --max-time 15 https://api.github.com/repos/yt-dlp/yt-dlp/releases/latest \
         | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)
[ -z "$latest" ] && exit 0
[ "$latest" = "$installed" ] && exit 0

# a new release is out: Homebrew usually ships it within a few hours
nice -n 10 brew upgrade --quiet yt-dlp >/dev/null 2>&1
now=$(yt-dlp --version 2>/dev/null)
if [ "$now" != "$installed" ]; then
  brew cleanup --quiet yt-dlp >/dev/null 2>&1
  mkdir -p "${LOG:h}"
  echo "$(date '+%Y-%m-%d %H:%M') yt-dlp $installed -> $now" >> "$LOG"
fi
